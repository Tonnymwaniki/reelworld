# ReelWorld settings. Copy to .env and fill in values. Never commit .env.
# Names only here — see README for what each one does.

# Supabase (photos table + search functions; see backend/schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Primary reasoning provider (Modal-hosted Muse Spark Open)
PARSER_BASE_URL=
PARSER_KEY_ENV=MODAL_API_KEY
PARSER_MODEL=
MODAL_API_KEY=

# Fallback reasoning provider (defaults to Baseten Muse Spark Open)
FALLBACK_BASE_URL=
FALLBACK_KEY_ENV=
FALLBACK_MODEL=
BASETEN_API_KEY=

# Meta API (original direct provider; used by annotate/place scripts)
META_API_KEY=
META_API_BASE_URL=
META_API_MODEL=
LLAMA_SPARK_MODEL=
LLAMA_SPARK_VISION_MODEL=
SAM_MODEL=

# Demo mode: true gates writes/uploads/publish behind DEMO_CODE
DEMO_MODE=true
DEMO_CODE=

# Budgets and rate limits (defaults shown)
DAILY_TOKEN_BUDGET=3000000
LLM_TIMEOUT_SECONDS=90
REQUESTS_PER_MINUTE=6
REQUESTS_PER_DAY=60

# Feature flags
FEATURE_OUTLINES=true
ENABLE_SWAHILI=false

# Studio voice (Modal Kokoro TTS; see docs/studio_voice.md)
STUDIO_VOICE_URL=
STUDIO_VOICE_KEY=

# Test-only switches (never set in production)
FORCE_PRIMARY_FAIL=false
FORCE_TOOLCALL_FAIL=false
